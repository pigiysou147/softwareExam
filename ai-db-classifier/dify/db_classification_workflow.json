{
  "name": "DB Classification Assistant",
  "type": "workflow",
  "version": "1.0",
  "nodes": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Inputs",
      "fields": [
        {"key": "database_url", "type": "string", "required": true, "default": "postgresql+psycopg://dify:dify@postgres:5432/difydb"},
        {"key": "policy_text", "type": "string", "required": false, "default": ""}
      ]
    },
    {
      "id": "http-introspect",
      "type": "http_request",
      "name": "Introspect",
      "method": "POST",
      "url": "http://schema-service:8000/introspect",
      "headers": [{"name": "Content-Type", "value": "application/json"}],
      "body": "{\n  \"database_url\": \"{{inputs.database_url}}\"\n}",
      "result": "schemaResp"
    },
    {
      "id": "llm-classify",
      "type": "llm",
      "name": "Classify",
      "provider": "openai_compatible",
      "model": "deepseek-r1:7b",
      "prompt": "你是数据库分级分类专家。根据策略与表结构为字段判定level与tags，并输出JSON数组。策略：\n{{inputs.policy_text}}\n结构：\n{{schemaResp.body.schema}}\n仅输出JSON数组。",
      "result": "llmContent"
    },
    {
      "id": "http-export",
      "type": "http_request",
      "name": "ExportExcel",
      "method": "POST",
      "url": "http://schema-service:8000/export-excel",
      "headers": [{"name": "Content-Type", "value": "application/json"}],
      "body": "{\n  \"classification\": {{llmContent}},\n  \"output_filename\": \"db_classification.xlsx\"\n}",
      "result": "exportResp"
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Result",
      "fields": [
        {"key": "file_path", "value": "{{exportResp.body.file_path}}"},
        {"key": "preview", "value": "{{llmContent[0:5]}}"}
      ]
    }
  ],
  "edges": [
    {"from": "input-1", "to": "http-introspect"},
    {"from": "http-introspect", "to": "llm-classify"},
    {"from": "llm-classify", "to": "http-export"},
    {"from": "http-export", "to": "output-1"}
  ]
}

